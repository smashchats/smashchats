{
  "expo": {
    "name": "Smashchats",
    "slug": "smashchats",
    "version": "1.3.0",
    "runtimeVersion": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smash",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "buildNumber": "12",
      "appleTeamId": "5P8Z824PGN",
      "associatedDomains": [
        "webcredentials:smashchats.com"
      ],
      "supportsTablet": true,
      "bundleIdentifier": "com.smashchats.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete",
        "com.apple.developer.networking.multipath": true,
        "com.apple.developer.usernotifications.communication": true,
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.smashchats"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera"
      }
    },
    "android": {
      "versionCode": 12,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.unstaticlabs.smashchats",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-vision-camera",
      "expo-localization",
      "expo-image-picker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
